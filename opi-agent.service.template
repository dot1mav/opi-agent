# opi-agent.service — hardened systemd unit template (generated by installer/agent)
# Install: sudo install -m 644 opi-agent.service.template /etc/systemd/system/opi-agent.service
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now opi-agent.service
# Replace /opt/opi-agent with your BASE_DIR if different.

[Unit]
Description=Orange Pi Agent (OPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opi-agent
Group=opi-agent
WorkingDirectory=/opt/opi-agent
ExecStart=/opt/opi-agent/.venv/bin/python /opt/opi-agent/opi_agent.py daemon
EnvironmentFile=/opt/opi-agent/.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

# فقط دایرکتوری‌های زمان اجرا قابل نوشتن هستند
ReadWritePaths=/opt/opi-agent/workspace /opt/opi-agent/run /opt/opi-agent/logs

# مسیرهای خارجی (مثل هارد اکسترنال) فقط خواندنی؛ برای نوشتن از گروه‌های سیستم
# فایل (OPI_EXTRA_GROUPS) یا ACL (OPI_GRANT_ACL=true) استفاده کنید.
ReadOnlyPaths=/mnt/usb1 /media/data

[Install]
WantedBy=multi-user.target
