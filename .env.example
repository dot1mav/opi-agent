# opi-agent environment — copy to .env (never commit .env)
OPI_BASE_DIR=/opt/opi
OPI_SERVICE_NAME=opi-agent
# Branch allowed for self-update (must be main unless explicitly changed here)
OPI_UPDATE_BRANCH=main
# Optional: pin expected origin URL; update aborts if it differs
# OPI_ORIGIN_URL=git@github.com:YOUR_USER/opi-agent.git
# Shell command execution is DISABLED by default; set true only if you
# really need it (still requires --confirm on the CLI)
OPI_SHELL_ENABLED=false
# Daemon heartbeat interval in seconds
OPI_HEARTBEAT_SECONDS=60
# Optional secrets (masked by `config show`)
# OPI_API_KEY=
